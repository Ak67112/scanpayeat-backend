{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...all]" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/api-docs/(.*)", "destination": "/api/index" },
    { "source": "/api-docs", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" }
  ]
}
