datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  SHOPKEEPER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Admin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Shop {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  subdomain     String         @unique
  address       String?
  state         String?
  district      String?
  phone         String?
  qrUrl         String?
  logoUrl       String?
  bannerUrl     String?
  description   String?
  ambienceImages String[]      @default([])
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Custom Shopkeeper Razorpay Gateway
  razorpayKeyId          String?
  razorpayKeySecret      String?       // Encrypted with AES-256-GCM
  isCustomGatewayEnabled Boolean       @default(false)

  // GST & Tax Configuration
  gstEnabled             Boolean       @default(false)
  cgstRate               Decimal       @default(2.50) @db.Decimal(5, 2)
  sgstRate               Decimal       @default(2.50) @db.Decimal(5, 2)
  gstNumber              String?

  // Dining & Table Service Configuration
  hasDining              Boolean       @default(false)
  tableCount             Int           @default(0)
  isOrderingEnabled      Boolean       @default(true)

  shopkeepers   Shopkeeper[]
  categories    Category[]
  products      Product[]
  orders        Order[]
  payments      Payment[]
  tokenCounters TokenCounter[]

  @@map("shops")
}

model Shopkeeper {
  id           Int      @id @default(autoincrement())
  shopId       Int
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  mobile       String?
  avatarUrl    String?
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  wallet       ShopkeeperWallet?

  @@index([shopId])
  @@map("shopkeepers")
}

model Customer {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  mobile       String?
  avatarUrl    String?
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders       Order[]
  payments     Payment[]

  @@map("customers")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  role      UserRole
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, role])
  @@map("refresh_tokens")
}

model Category {
  id          Int       @id @default(autoincrement())
  shopId      Int
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  shopId      Int
  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orderItems  OrderItem[]

  @@index([shopId])
  @@index([categoryId])
  @@map("products")
}

model Order {
  id            Int                  @id @default(autoincrement())
  orderCode     String               @unique
  shopId        Int
  shop          Shop                 @relation(fields: [shopId], references: [id])
  customerId    Int?
  customer      Customer?            @relation(fields: [customerId], references: [id])
  customerName  String?
  customerPhone String?
  tokenNumber   String?
  orderStatus   OrderStatus          @default(PENDING)
  paymentStatus PaymentStatus        @default(PENDING)
  subtotal      Decimal              @db.Decimal(10, 2)
  discountAmount Decimal             @default(0.00) @db.Decimal(10, 2)
  couponCode    String?
  discountReason String?
  taxableAmount Decimal?             @db.Decimal(10, 2)
  cgstRate      Decimal              @default(0.00) @db.Decimal(5, 2)
  sgstRate      Decimal              @default(0.00) @db.Decimal(5, 2)
  cgstAmount    Decimal              @default(0.00) @db.Decimal(10, 2)
  sgstAmount    Decimal              @default(0.00) @db.Decimal(10, 2)
  tax           Decimal              @default(0.00) @db.Decimal(10, 2)
  totalAmount   Decimal              @db.Decimal(10, 2)
  notes         String?
  tableNumber   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]

  @@index([shopId])
  @@index([customerId])
  @@index([orderStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                Int           @id @default(autoincrement())
  orderId           Int
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopId            Int
  shop              Shop          @relation(fields: [shopId], references: [id])
  customerId        Int?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  provider          String        @default("RAZORPAY")
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([shopId])
  @@index([customerId])
  @@map("payments")
}

model TokenCounter {
  id           Int      @id @default(autoincrement())
  shopId       Int
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date         String   // YYYY-MM-DD
  lastSequence Int      @default(100)
  updatedAt    DateTime @updatedAt

  @@unique([shopId, date])
  @@index([shopId])
  @@map("token_counters")
}

model OrderStatusHistory {
  id            Int       @id @default(autoincrement())
  orderId       Int
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        OrderStatus
  notes         String?
  changedByRole UserRole?
  changedById   Int?
  createdAt     DateTime  @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model PaymentWebhookEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique
  eventType   String
  payload     Json
  status      String   @default("PROCESSED")
  processedAt DateTime @default(now())

  @@map("payment_webhook_events")
}

model Coupon {
  id             Int       @id @default(autoincrement())
  shopId         Int?
  code           String    @unique
  discountType   String    @default("FIXED") // FIXED or PERCENT
  discountValue  Decimal   @db.Decimal(10, 2)
  minOrderAmount Decimal   @default(0.00) @db.Decimal(10, 2)
  maxDiscount    Decimal?  @db.Decimal(10, 2)
  isActive       Boolean   @default(true)
  expiresAt         DateTime?
  usageCount        Int       @default(0)
  targetState       String?
  targetDistrict    String?
  applicableShopIds Int[]     @default([])
  createdAt         DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([shopId])
  @@map("coupons")
}

model ShopRewardRule {
  id             Int      @id @default(autoincrement())
  shopId         Int      @unique
  milestoneCount Int      @default(10) // e.g. 10th customer of the day, 100th, etc.
  discountAmount Decimal  @default(50.00) @db.Decimal(10, 2)
  minOrderAmount Decimal  @default(100.00) @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  title          String   @default("Today's Lucky Customer Celebration")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("shop_reward_rules")
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
}

model PaymentGatewaySetting {
  id                Int      @id @default(autoincrement())
  provider          String   @default("RAZORPAY")
  keyId             String
  keySecret         String   // Encrypted at application layer
  webhookSecret     String?
  environment       String   @default("TEST") // "TEST" | "LIVE"
  currency          String   @default("INR")
  platformFeeType   String   @default("PERCENT") // "PERCENT" | "FIXED"
  platformFeeValue  Decimal  @default(2.00) @db.Decimal(10, 2) // e.g. 2% or flat fee
  isActive          Boolean  @default(true)
  updatedByAdminId  Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("payment_gateway_settings")
}

model ShopkeeperWallet {
  id             Int                 @id @default(autoincrement())
  shopkeeperId   Int                 @unique
  shopkeeper     Shopkeeper          @relation(fields: [shopkeeperId], references: [id], onDelete: Cascade)
  balance        Decimal             @default(0.00) @db.Decimal(10, 2)
  minWalletLimit Decimal             @default(0.00) @db.Decimal(10, 2)
  isQrEnabled    Boolean             @default(true)
  totalCredits   Decimal             @default(0.00) @db.Decimal(10, 2)
  totalDebits    Decimal             @default(0.00) @db.Decimal(10, 2)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  transactions   WalletTransaction[]

  @@map("shopkeeper_wallets")
}

model WalletTransaction {
  id              Int                   @id @default(autoincrement())
  walletId        Int
  wallet          ShopkeeperWallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type            WalletTransactionType
  amount          Decimal               @db.Decimal(10, 2)
  previousBalance Decimal               @db.Decimal(10, 2)
  newBalance      Decimal               @db.Decimal(10, 2)
  reference       String                // e.g. "ADM-CR-1728574892", "ORD1728574892"
  idempotencyKey  String?               @unique
  adminId         Int?
  orderId         Int?
  notes           String?
  metadata        Json?
  createdAt       DateTime              @default(now())

  @@index([walletId])
  @@index([reference])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model PartnerEnquiry {
  id              Int      @id @default(autoincrement())
  referenceId     String   @unique
  restaurantName  String
  contactName     String
  mobile          String
  email           String?
  city            String?
  state           String?
  outletType      String?
  estimatedTables String?
  message         String?
  status          String   @default("PENDING") // PENDING, CONTACTED, ONBOARDED, REJECTED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("partner_enquiries")
}


