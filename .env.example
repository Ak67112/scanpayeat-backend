PORT=5001
NODE_ENV=production

# Database Connection String
DATABASE_URL="postgresql://user:password@hostname:5432/defaultdb?sslmode=require"

# JWT Configuration
JWT_ACCESS_SECRET="your_super_secret_access_jwt_key_scanpayeat_32_chars_min"
JWT_REFRESH_SECRET="your_super_secret_refresh_jwt_key_scanpayeat_32_chars_min"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Razorpay Configuration
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Cookies & Domain
COOKIE_DOMAIN="vercel.app"
FRONTEND_URL="https://scanpayeat-frontend.vercel.app"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"
